<Window x:Class="TextBean.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TextBean.ViewModels"
        xmlns:platform="clr-namespace:TextBean.Views.Platform"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="TextBean" Width="1000" Height="640">
  <!-- 트리 아이콘. 이미지 파일이 아니라 벡터로 둔다 —
       단일 파일 게시라 이미지가 들어가면 빌드 설정(Resource/Content)에 묶이고,
       그게 조용히 빠지면 아이콘만 안 뜨면서 빌드는 통과한다. 벡터는 DPI 도 안 탄다.
       창 안에 두는 이유: App.xaml 에 두면 창을 따로 띄우는 검증 프로브가 전부 깨진다. -->
  <Window.Resources>
    <DrawingImage x:Key="FolderIcon">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <!-- 세 아이콘이 같은 경계 상자를 쓰게 못 박는다.
               Image 는 Stretch=Uniform 이 기본이라 DrawingImage 자신의 경계 상자를 16x16 에 맞춰 늘린다.
               상자가 제각각이면 배율도 달라져, 같은 좌표에 그린 도형이 화면에서는 어긋난다 —
               자물쇠 배지가 상자를 x=15.2 까지 넓히는 바람에 폴더 x1.333 / 자물쇠 문서 x1.168 /
               평문 문서 x1.240 로 셋이 전부 달랐고, 두 문서가 크기도 위치도 안 맞았다 [실측].
               투명한 도형도 경계 계산에는 들어가므로 이 한 줄이면 배율이 전부 x1.000 이 된다.
               상자는 세 아이콘을 모두 감싸는 최소 크기다 — 바꾸려면 반드시 세 곳을 함께 바꾼다. -->
          <GeometryDrawing Brush="Transparent">
            <GeometryDrawing.Geometry>
              <RectangleGeometry Rect="2,1.5,13.2,13.7" />
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
          <GeometryDrawing Brush="#73B4B2A9"
                           Geometry="M2,4.2 A1.2,1.2 0 0 1 3.2,3 H6.1 C6.5,3 6.9,3.2 7.1,3.5 L7.9,4.6 H12.8 A1.2,1.2 0 0 1 14,5.8 V12.2 A1.2,1.2 0 0 1 12.8,13.4 H3.2 A1.2,1.2 0 0 1 2,12.2 Z" />
          <GeometryDrawing Brush="#888780"
                           Geometry="M2,6.6 H14 V12.2 A1.2,1.2 0 0 1 12.8,13.4 H3.2 A1.2,1.2 0 0 1 2,12.2 Z" />
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 문서 본체는 옅은 면, 접힌 모서리는 진한 면, 오른쪽 아래에 자물쇠 배지.
         얇은 선으로 그리면 16px 로 줄일 때 뭉갠다 — 면으로 채워야 형태가 남는다. -->
    <DrawingImage x:Key="DocumentLockedIcon">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <!-- 경계 상자 통일. 이유는 FolderIcon 의 주석 참조 — 세 곳이 같아야 한다. -->
          <GeometryDrawing Brush="Transparent">
            <GeometryDrawing.Geometry>
              <RectangleGeometry Rect="2,1.5,13.2,13.7" />
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
          <GeometryDrawing Brush="#665DCAA5"
                           Geometry="M3.4,2.6 A1.1,1.1 0 0 1 4.5,1.5 H8.7 L12.6,5.4 V13.3 A1.1,1.1 0 0 1 11.5,14.4 H4.5 A1.1,1.1 0 0 1 3.4,13.3 Z" />
          <GeometryDrawing Brush="#8C0F6E56"
                           Geometry="M8.7,1.5 L12.6,5.4 H9.8 A1.1,1.1 0 0 1 8.7,4.3 Z" />
          <!-- 배지가 크면 16px 에서 문서 모양이 사라지고 '초록 동그라미'로만 읽힌다 [실측].
               문서가 드러날 만큼 줄이고, 대신 자물쇠를 굵게 그려 작은 크기에서도 남게 한다. -->
          <GeometryDrawing Brush="#0F6E56">
            <GeometryDrawing.Geometry>
              <EllipseGeometry Center="11.9,11.9" RadiusX="3.3" RadiusY="3.3" />
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
          <GeometryDrawing Brush="White">
            <GeometryDrawing.Geometry>
              <RectangleGeometry Rect="10.55,11.75,2.7,2.3" RadiusX="0.45" RadiusY="0.45" />
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
          <GeometryDrawing Geometry="M11.2,11.75 V11.0 A0.7,0.7 0 0 1 12.6,11.0 V11.75">
            <GeometryDrawing.Pen>
              <Pen Brush="White" Thickness="0.75" />
            </GeometryDrawing.Pen>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 암호화되지 않은 문서(.txt). 배지 대신 색과 줄무늬로 가른다 —
         평문이 여럿이어도 트리가 경고투성이가 되지 않는다.
         .txt 지원이 들어오면 위 트리 템플릿이 이 아이콘을 고른다. -->
    <DrawingImage x:Key="DocumentPlainIcon">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <!-- 경계 상자 통일. 이유는 FolderIcon 의 주석 참조 — 세 곳이 같아야 한다. -->
          <GeometryDrawing Brush="Transparent">
            <GeometryDrawing.Geometry>
              <RectangleGeometry Rect="2,1.5,13.2,13.7" />
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
          <GeometryDrawing Brush="#8CFAC775"
                           Geometry="M3.4,2.6 A1.1,1.1 0 0 1 4.5,1.5 H8.7 L12.6,5.4 V13.3 A1.1,1.1 0 0 1 11.5,14.4 H4.5 A1.1,1.1 0 0 1 3.4,13.3 Z" />
          <GeometryDrawing Brush="#80854F0B"
                           Geometry="M8.7,1.5 L12.6,5.4 H9.8 A1.1,1.1 0 0 1 8.7,4.3 Z" />
          <GeometryDrawing Geometry="M5.6,8.4 H10.4 M5.6,10.4 H10.4 M5.6,12.4 H8.6">
            <GeometryDrawing.Pen>
              <Pen Brush="#A6854F0B" Thickness="0.9" StartLineCap="Round" EndLineCap="Round" />
            </GeometryDrawing.Pen>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 트리의 "지금 키로 열리지 않음"과 탭의 "읽기 전용"은 같은 흐림이다 — 값이 두 벌이면 한쪽만 바뀐다. -->
    <sys:Double x:Key="DimmedOpacity">0.45</sys:Double>

    <!-- 탭 상태 아이콘(제목 앞). 머리글과 ▾ 목록이 함께 쓴다 — 규칙이 두 벌이 되면 한쪽만 고쳐진다.
         그림은 트리와 같은 문서 아이콘이다 — 탭만 디스크 · 자물쇠 · 종이를 쓰면 같은 파일이 두 그림으로 보였고,
         자물쇠가 트리에서는 "암호화됨", 탭에서는 "읽기 전용"이라 거꾸로 읽혔다(사용자 지적 — D-091).
         저장 상태는 그림 위에 얹는다: 저장 전 = 오른쪽 위 빨간 점 · 저장 실패 = ⚠(그림 대신) · 읽기 전용 = 트리처럼 흐리게.
         칸은 늘 16×16 이다 — 상태가 바뀌어도 탭 폭이 그대로라, 아슬아슬한 폭에서 ◀▶▾ 가 깜빡이지 않는다 [실측 — 적대 검토].
         그림은 파일 종류(IsPlainTextFile — 트리와 같은 경로 판정)로 고른다. 읽기에 실패한 .txt 도 트리처럼 평문 그림이고, 열리지 않았으니 흐리다(사용자 판정).
         흐림을 푸는 것은 읽기에 성공한 평문(IsPlainText)일 때뿐이다 — 평문의 읽기 전용은 고칠 수 없는 상태가 아니라 파일 종류다(D-025).
         뒤의 트리거가 앞을 이긴다 — 평문 트리거는 맨 뒤에 둔다. DataContext 는 탭(EditorViewModel)이다. -->
    <DataTemplate x:Key="TabStateIcon">
      <Grid Width="16" Height="16" VerticalAlignment="Center">
        <Image x:Name="Doc" Source="{StaticResource DocumentLockedIcon}"
               SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality" />
        <Viewbox x:Name="Warn" Visibility="Collapsed">
          <Grid Width="12" Height="12">
            <Path Fill="#E08A00" Data="M6,0.4 L11.7,11.3 H0.3 Z" />
            <Path Fill="White" Data="M5.35,3.8 H6.65 L6.45,7.7 H5.55 Z M5.35,8.5 H6.65 V9.8 H5.35 Z" />
          </Grid>
        </Viewbox>
        <Ellipse x:Name="Dot" Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Fill="#D0392B" Stroke="{DynamicResource SurfaceBrush}" StrokeThickness="1.2" Visibility="Collapsed" />
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding SaveState}" Value="Saving">
          <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding SaveState}" Value="Failed">
          <Setter TargetName="Doc" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="Warn" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding SaveState}" Value="ReadOnly">
          <Setter TargetName="Doc" Property="Opacity" Value="{StaticResource DimmedOpacity}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsPlainTextFile}" Value="True">
          <Setter TargetName="Doc" Property="Source" Value="{StaticResource DocumentPlainIcon}" />
        </DataTrigger>
        <!-- 평문도 고칠 수 있다 (D-117) — 저장 전 점 · 실패 ⚠ 를 금고 문서와 똑같이 보인다 -->
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ▾ 열린 탭 목록의 한 줄. DataContext 는 TabListEntry(탭 · 같은 제목일 때만 폴더) -->
    <DataTemplate x:Key="TabListItemTemplate">
      <StackPanel Orientation="Horizontal">
        <Grid Width="16">
          <TextBlock Text="✓" Foreground="{DynamicResource AccentBrush}"
                     Visibility="{Binding Tab.IsActive, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
        <ContentPresenter Content="{Binding Tab}" ContentTemplate="{StaticResource TabStateIcon}" Margin="0,0,6,0" />
        <TextBlock Text="{Binding Tab.TabTitle}" MaxWidth="360" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Folder}" Margin="10,0,0,0" Foreground="Gray" VerticalAlignment="Center" />
      </StackPanel>
    </DataTemplate>

    <!-- 탭 줄 ◀ ▶ ▾. 포커스를 가져가지 않는다 — 넘기는 동안 본문 입력이 끊기지 않게.
         끝에 닿은 쪽은 흐리게(도구 모음 버튼 모양은 비활성 글자색만 바꾸고 그림은 그대로라). -->
    <!-- 납작한 단추 (D-164). Fluent 의 도구 모음 단추 모양은 높이를 바꿔도 글자가 잘려 [실측 — 계획 탐침] 모양을 직접 그린다.
         바탕만 테마 색 — 글자색은 창(Fluent)에서 물려받는다. 마우스를 올리면 옅게 · 누르거나 목록이 열려 있으면 진하게 · 꺼지면 흐리게. -->
    <Style x:Key="FlatButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <!-- 직접 정한 스타일은 Fluent 를 잇지 않아 예전 기본 글자색(검정)이 된다 — Fluent 본문 글자색으로 (D-168) -->
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Face" Property="Background" Value="{DynamicResource ButtonPressedBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Face" Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FlatToggle" TargetType="ToggleButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Face" Property="Background" Value="{DynamicResource ButtonPressedBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Face" Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TabStripButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="Margin" Value="0,2,0,0" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.35" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- 서식 도구 모음 단추 (D-127). 포커스를 가져가지 않는다 — 본문의 선택이 남아 있어야 서식이 그 선택에 칠해진다. -->
    <Style x:Key="FormatButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="MinWidth" Value="28" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="Margin" Value="0,0,2,0" />
    </Style>
    <Style x:Key="FormatToggle" TargetType="ToggleButton" BasedOn="{StaticResource FlatToggle}">
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="Margin" Value="0,0,2,0" />
    </Style>
    <Style x:Key="Swatch" TargetType="Button" BasedOn="{StaticResource FlatButton}">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="3" />
    </Style>

    <!-- .txt 본문 — 서식을 담지 못한다 (D-125). -->
    <DataTemplate x:Key="PlainBodyTemplate">
      <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
               IsReadOnly="{Binding IsReadOnly}"
               platform:EditorBehavior.InterceptCopy="True"
               platform:SearchHighlightBehavior.ShowMatches="True"
               AcceptsReturn="True" AcceptsTab="True"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
               FontFamily="{Binding Path=(platform:AppFonts.Body)}" FontSize="13"
               AllowDrop="False" Padding="10" BorderThickness="0" />
    </DataTemplate>

    <!-- .tbx 본문 — 서식 6종 (D-125 · D-127). 도구 모음과 본문을 한 템플릿에 둔다 — 단추의 CommandTarget 이 이름으로 본문을 찾는다. -->
    <DataTemplate x:Key="RichBodyTemplate">
      <DockPanel>
        <Border DockPanel.Dock="Top" Padding="8,3" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource FormatBarLineBrush}" Background="{DynamicResource FormatBarBrush}"
                Visibility="{Binding ShowFormatBar, Converter={StaticResource BoolToVisibility}}">
          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource FormatButton}" Command="EditingCommands.ToggleBold"
                    CommandTarget="{Binding ElementName=Body}" ToolTip="굵게 (Ctrl+B)">
              <TextBlock Text="가" FontWeight="Bold" />
            </Button>
            <Button Style="{StaticResource FormatButton}" Command="EditingCommands.ToggleItalic"
                    CommandTarget="{Binding ElementName=Body}" ToolTip="기울임 (Ctrl+I)">
              <TextBlock Text="가" FontStyle="Italic" />
            </Button>
            <Button Style="{StaticResource FormatButton}" Command="{x:Static platform:RichFormat.ToggleUnderline}"
                    CommandTarget="{Binding ElementName=Body}" ToolTip="밑줄 (Ctrl+U)">
              <TextBlock Text="가" TextDecorations="Underline" />
            </Button>
            <Button Style="{StaticResource FormatButton}" Command="{x:Static platform:RichFormat.ToggleStrikethrough}"
                    CommandTarget="{Binding ElementName=Body}" ToolTip="취소선 (Ctrl+Shift+X)">
              <TextBlock Text="가" TextDecorations="Strikethrough" />
            </Button>
            <Rectangle Width="1" Height="18" Margin="6,0" Fill="{DynamicResource SeparatorBrush}" />

            <ToggleButton x:Name="TextColorToggle" Style="{StaticResource FormatToggle}" ToolTip="글자색"
                          IsChecked="{Binding IsOpen, ElementName=TextColorPopup}">
              <StackPanel Orientation="Horizontal">
                <Border BorderBrush="{DynamicResource TextColor.빨강.Brush}" BorderThickness="0,0,0,3"><TextBlock Text="가" /></Border>
                <TextBlock Text=" ▾" Foreground="{DynamicResource MutedTextBrush}" />
              </StackPanel>
            </ToggleButton>
            <Popup x:Name="TextColorPopup" StaysOpen="False" PlacementTarget="{Binding ElementName=TextColorToggle}">
              <Border Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource PopupLineBrush}" BorderThickness="1" Padding="4">
                <StackPanel Orientation="Horizontal" ButtonBase.Click="OnFormatPopupPick">
                  <Button Style="{StaticResource Swatch}" Width="Auto" Padding="6,0" Content="기본"
                          Command="{x:Static platform:RichFormat.SetForeground}" CommandParameter=""
                          CommandTarget="{Binding ElementName=Body}" />
                  <Button Style="{StaticResource Swatch}" ToolTip="빨강" Command="{x:Static platform:RichFormat.SetForeground}"
                          CommandParameter="빨강" CommandTarget="{Binding ElementName=Body}"><Rectangle Width="18" Height="18" Fill="{DynamicResource TextColor.빨강.Brush}" Stroke="{DynamicResource SwatchLineBrush}" StrokeThickness="0.5" /></Button>
                  <Button Style="{StaticResource Swatch}" ToolTip="주황" Command="{x:Static platform:RichFormat.SetForeground}"
                          CommandParameter="주황" CommandTarget="{Binding ElementName=Body}"><Rectangle Width="18" Height="18" Fill="{DynamicResource TextColor.주황.Brush}" Stroke="{DynamicResource SwatchLineBrush}" StrokeThickness="0.5" /></Button>
                  <Button Style="{StaticResource Swatch}" ToolTip="초록" Command="{x:Static platform:RichFormat.SetForeground}"
                          CommandParameter="초록" CommandTarget="{Binding ElementName=Body}"><Rectangle Width="18" Height="18" Fill="{DynamicResource TextColor.초록.Brush}" Stroke="{DynamicResource SwatchLineBrush}" StrokeThickness="0.5" /></Button>
                  <Button Style="{StaticResource Swatch}" ToolTip="파랑" Command="{x:Static platform:RichFormat.SetForeground}"
                          CommandParameter="파랑" CommandTarget="{Binding ElementName=Body}"><Rectangle Width="18" Height="18" Fill="{DynamicResource TextColor.파랑.Brush}" Stroke="{DynamicResource SwatchLineBrush}" StrokeThickness="0.5" /></Button>
                  <Button Style="{StaticResource Swatch}" ToolTip="보라" Command="{x:Static platform:RichFormat.SetForeground}"
                          CommandParameter="보라" CommandTarget="{Binding ElementName=Body}"><Rectangle Width="18" Height="18" Fill="{DynamicResource TextColor.보라.Brush}" Stroke="{DynamicResource SwatchLineBrush}" StrokeThickness="0.5" /></Button>
                  <Button Style="{StaticResource Swatch}" ToolTip="회색" Command="{x:Static platform:RichFormat.SetForeground}"
                          CommandParameter="회색" CommandTarget="{Binding ElementName=Body}"><Rectangle Width="18" Height="18" Fill="{DynamicResource TextColor.회색.Brush}" Stroke="{DynamicResource SwatchLineBrush}" StrokeThickness="0.5" /></Button>
                </StackPanel>
              </Border>
            </Popup>

            <ToggleButton x:Name="HighlightToggle" Style="{StaticResource FormatToggle}" ToolTip="형광펜"
                          IsChecked="{Binding IsOpen, ElementName=HighlightPopup}">
              <StackPanel Orientation="Horizontal">
                <Border Background="{DynamicResource Highlight.노랑.Brush}" Padding="3,0">
                  <TextBlock Text="형광펜" Foreground="{DynamicResource HighlightLabelTextBrush}" />
                </Border>
                <TextBlock Text=" ▾" Foreground="{DynamicResource MutedTextBrush}" />
              </StackPanel>
            </ToggleButton>
            <Popup x:Name="HighlightPopup" StaysOpen="False" PlacementTarget="{Binding ElementName=HighlightToggle}">
              <Border Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource PopupLineBrush}" BorderThickness="1" Padding="4">
                <StackPanel Orientation="Horizontal" ButtonBase.Click="OnFormatPopupPick">
                  <Button Style="{StaticResource Swatch}" Width="Auto" Padding="6,0" Content="없음"
                          Command="{x:Static platform:RichFormat.SetHighlight}" CommandParameter=""
                          CommandTarget="{Binding ElementName=Body}" />
                  <Button Style="{StaticResource Swatch}" ToolTip="노랑" Command="{x:Static platform:RichFormat.SetHighlight}"
                          CommandParameter="노랑" CommandTarget="{Binding ElementName=Body}"><Rectangle Width="18" Height="18" Fill="{DynamicResource Highlight.노랑.Brush}" Stroke="{DynamicResource SwatchLineBrush}" StrokeThickness="0.5" /></Button>
                  <Button Style="{StaticResource Swatch}" ToolTip="연두" Command="{x:Static platform:RichFormat.SetHighlight}"
                          CommandParameter="연두" CommandTarget="{Binding ElementName=Body}"><Rectangle Width="18" Height="18" Fill="{DynamicResource Highlight.연두.Brush}" Stroke="{DynamicResource SwatchLineBrush}" StrokeThickness="0.5" /></Button>
                  <Button Style="{StaticResource Swatch}" ToolTip="하늘" Command="{x:Static platform:RichFormat.SetHighlight}"
                          CommandParameter="하늘" CommandTarget="{Binding ElementName=Body}"><Rectangle Width="18" Height="18" Fill="{DynamicResource Highlight.하늘.Brush}" Stroke="{DynamicResource SwatchLineBrush}" StrokeThickness="0.5" /></Button>
                  <Button Style="{StaticResource Swatch}" ToolTip="분홍" Command="{x:Static platform:RichFormat.SetHighlight}"
                          CommandParameter="분홍" CommandTarget="{Binding ElementName=Body}"><Rectangle Width="18" Height="18" Fill="{DynamicResource Highlight.분홍.Brush}" Stroke="{DynamicResource SwatchLineBrush}" StrokeThickness="0.5" /></Button>
                  <Button Style="{StaticResource Swatch}" ToolTip="빨강" Command="{x:Static platform:RichFormat.SetHighlight}"
                          CommandParameter="빨강" CommandTarget="{Binding ElementName=Body}"><Rectangle Width="18" Height="18" Fill="{DynamicResource Highlight.빨강.Brush}" Stroke="{DynamicResource SwatchLineBrush}" StrokeThickness="0.5" /></Button>
                </StackPanel>
              </Border>
            </Popup>

            <!-- 글자 크기 (D-151) — 단추 글자는 지금 커서 · 고른 곳의 크기. Ctrl+] · Ctrl+[ 는 다음 · 이전 크기 -->
            <ToggleButton x:Name="SizeToggle" Style="{StaticResource FormatToggle}" ToolTip="글자 크기 (Ctrl+] · Ctrl+[)"
                          IsChecked="{Binding IsOpen, ElementName=SizePopup}">
              <TextBlock Text="{Binding (platform:RichFormat.CurrentSize), ElementName=Body, StringFormat={}{0} ▾}" />
            </ToggleButton>
            <Popup x:Name="SizePopup" StaysOpen="False" PlacementTarget="{Binding ElementName=SizeToggle}">
              <Border Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource PopupLineBrush}" BorderThickness="1" Padding="2">
                <StackPanel ButtonBase.Click="OnFormatPopupPick">
                  <StackPanel.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource FormatButton}">
                      <Setter Property="HorizontalContentAlignment" Value="Left" />
                      <Setter Property="Padding" Value="12,0" />
                      <Setter Property="Margin" Value="0" />
                      <Setter Property="Command" Value="{x:Static platform:RichFormat.SetFontSize}" />
                      <Setter Property="CommandTarget" Value="{Binding ElementName=Body}" />
                    </Style>
                  </StackPanel.Resources>
                  <Button Content="10" CommandParameter="10" />
                  <Button Content="12" CommandParameter="12" />
                  <Button Content="13 · 기본" CommandParameter="13" />
                  <Button Content="16" CommandParameter="16" />
                  <Button Content="20" CommandParameter="20" />
                  <Button Content="24" CommandParameter="24" />
                  <Button Content="32" CommandParameter="32" />
                </StackPanel>
              </Border>
            </Popup>
            <Rectangle Width="1" Height="18" Margin="6,0" Fill="{DynamicResource SeparatorBrush}" />

            <!-- 음성 입력 (D-180) — 셸 명령이라 창 DataContext 로 간다. 어느 탭의 도구 막대에서나 같은 상태다 -->
            <Button Style="{StaticResource FormatButton}" ToolTip="음성 입력 — 말하면 쉴 때마다 받아써 넣습니다. 다시 누르면 멈춥니다"
                    Content="{Binding DataContext.DictationButtonText, RelativeSource={RelativeSource AncestorType=Window}}"
                    Command="{Binding DataContext.ToggleDictationCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <!-- 그림 넣기 (D-140) — 파일에서. 캡처는 Ctrl+V 로 붙인다 -->
            <Button Style="{StaticResource FormatButton}" Content="그림" ToolTip="파일에서 그림 넣기 (캡처는 Ctrl+V)"
                    Command="{x:Static platform:RichImage.InsertFromFile}" CommandTarget="{Binding ElementName=Body}" />
            <!-- 표 넣기 (D-131) — 8×8 격자에서 고른다 -->
            <ToggleButton x:Name="TableToggle" Style="{StaticResource FormatToggle}" ToolTip="표 넣기"
                          IsChecked="{Binding IsOpen, ElementName=TablePopup}">
              <TextBlock Text="표 ▾" />
            </ToggleButton>
            <Popup x:Name="TablePopup" StaysOpen="False" PlacementTarget="{Binding ElementName=TableToggle}">
              <Border Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource PopupLineBrush}" BorderThickness="1" Padding="6">
                <platform:TableSizePicker Command="{x:Static platform:RichTable.InsertTable}"
                                          CommandTarget="{Binding ElementName=Body}" Picked="OnFormatPopupPick" />
              </Border>
            </Popup>
            <Rectangle Width="1" Height="18" Margin="6,0" Fill="{DynamicResource SeparatorBrush}" />

            <Button Style="{StaticResource FormatButton}" Content="서식 지우기"
                    Command="{x:Static platform:RichFormat.ClearFormatting}" CommandTarget="{Binding ElementName=Body}" />
          </StackPanel>
        </Border>
        <RichTextBox x:Name="Body"
                     ContextMenuOpening="OnBodyContextMenuOpening"
                     IsReadOnly="{Binding IsReadOnly}"
                     platform:RichBodyBehavior.Attach="True"
                     platform:EditorBehavior.InterceptCopy="True"
                     platform:SearchHighlightBehavior.ShowMatches="True"
                     AcceptsReturn="True" AcceptsTab="True"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="{Binding Path=(platform:AppFonts.Body)}" FontSize="13"
                     Foreground="{DynamicResource BodyTextBrush}"
                     AllowDrop="False" Padding="10" BorderThickness="0">
          <RichTextBox.Resources>
            <!-- Fluent 의 FlowDocument 스타일이 글꼴 · 크기를 Georgia 16 으로 덮는다 [실측 — 계획 탐침] — 본문 글꼴 · 13 으로 되돌린다 (D-163).
                 본문 글자색(BodyTextBrush)은 박힌 기본색 목록에 있다 — 저장 때 박혀도 다시 열면 지워진다 (D-162) -->
            <Style TargetType="FlowDocument">
              <Setter Property="FontFamily" Value="{Binding Path=(platform:AppFonts.Body)}" />
              <Setter Property="FontSize" Value="13" />
            </Style>
            <!-- FlowDocument 문단은 기본으로 위아래 여백이 한 줄씩 있다 — TextBox 와 같은 줄 간격으로 맞춘다 -->
            <Style TargetType="Paragraph">
              <Setter Property="Margin" Value="0" />
            </Style>
            <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
              <Setter Property="CommandTarget" Value="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            </Style>
          </RichTextBox.Resources>
          <!-- 우클릭 메뉴 (D-132). 잘라내기 · 복사 · 붙여넣기는 기본 메뉴와 같은 명령 — 복사 가로채기를 그대로 탄다.
               Tag="table" 항목은 표 안일 때만 보인다(OnBodyContextMenuOpening). -->
          <RichTextBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="잘라내기" Command="ApplicationCommands.Cut" />
              <MenuItem Header="복사" Command="ApplicationCommands.Copy" />
              <MenuItem Header="붙여넣기" Command="ApplicationCommands.Paste" />
              <Separator Tag="table" />
              <MenuItem Tag="table" Header="위에 행 넣기" Command="{x:Static platform:RichTable.InsertRowAbove}" />
              <MenuItem Tag="table" Header="아래에 행 넣기" Command="{x:Static platform:RichTable.InsertRowBelow}" />
              <MenuItem Tag="table" Header="왼쪽에 열 넣기" Command="{x:Static platform:RichTable.InsertColumnLeft}" />
              <MenuItem Tag="table" Header="오른쪽에 열 넣기" Command="{x:Static platform:RichTable.InsertColumnRight}" />
              <Separator Tag="table" />
              <MenuItem Tag="table" Header="행 지우기" Command="{x:Static platform:RichTable.DeleteRow}" />
              <MenuItem Tag="table" Header="열 지우기" Command="{x:Static platform:RichTable.DeleteColumn}" />
              <Separator Tag="table" />
              <!-- 칸 합치기 · 풀기 (D-175) — 합치기는 여러 칸을 골랐을 때, 나누기는 합친 칸 안일 때만 된다(아니면 흐리게) -->
              <MenuItem Tag="table" Header="칸 합치기" Command="{x:Static platform:RichTable.MergeCells}" />
              <MenuItem Tag="table" Header="칸 나누기" Command="{x:Static platform:RichTable.SplitCell}" />
              <Separator Tag="table" />
              <!-- 칸 안 가로 정렬 (D-172) — 고른 칸들. 우클릭에서만(사용자 판정).
                   하위 메뉴(정렬 ▸)로 두지 않는다 — 하위 항목은 다른 팝업이라 위 MenuItem 스타일의 CommandTarget(AncestorType=ContextMenu)이
                   닿는지 화면 밖 시험으로 볼 수 없다. 닿지 않으면 「눌러도 무반응」이 된다(TabItem 우클릭 메뉴 주석과 같은 함정) -->
              <MenuItem Tag="table" Header="왼쪽 정렬" Command="{x:Static platform:RichTable.AlignCells}" CommandParameter="Left" />
              <MenuItem Tag="table" Header="가운데 정렬" Command="{x:Static platform:RichTable.AlignCells}" CommandParameter="Center" />
              <MenuItem Tag="table" Header="오른쪽 정렬" Command="{x:Static platform:RichTable.AlignCells}" CommandParameter="Right" />
              <Separator Tag="table" />
              <MenuItem Tag="table" Header="표 지우기" Command="{x:Static platform:RichTable.DeleteTable}" Foreground="{DynamicResource DangerTextBrush}" />
              <Separator Tag="image" />
              <MenuItem Tag="image" Header="원래 크기" Command="{x:Static platform:RichImage.OriginalSize}" />
              <MenuItem Tag="image" Header="그림 지우기" Command="{x:Static platform:RichImage.DeleteImage}" Foreground="{DynamicResource DangerTextBrush}" />
            </ContextMenu>
          </RichTextBox.ContextMenu>
        </RichTextBox>
      </DockPanel>
    </DataTemplate>
  </Window.Resources>

  <!-- 창 단축키는 코드가 셸의 키 표로 만든다 — 사용자가 바꿀 수 있다 (D-110, MainWindow.ApplyShortcuts).
       본문 TextBox 가 먼저 쓰는 키는 고를 수 없다 (D-112) -->

  <DockPanel>
    <!-- 위 줄 메뉴 (D-158) — 파일 · 편집 · 보기 · 보안 · 도움말. 명령은 예전 도구 모음 단추와 같다 — 놓는 자리만 바뀌었다.
         오른쪽 글자는 단축키 표를 따른다(D-159) — 단축키 설정에서 바꾼 키가 그대로 보인다.
         메뉴 이름에 밑줄 글자(Alt+F)는 달지 않는다 — 사용자 Alt 조합 단축키와 겹치지 않게 (D-160) -->
    <!-- 아래 1px 선 — 메뉴 줄과 트리 · 본문을 가른다 (D-166, 사용자 판정 「선만」) -->
    <Menu x:Name="TopMenu" DockPanel.Dock="Top" Padding="2"
          BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1">
      <MenuItem Header="파일">
        <MenuItem Header="새 문서" Command="{Binding NewDocumentCommand}" InputGestureText="{Binding Shortcuts[newDocument]}" />
        <MenuItem Header="새 폴더" Command="{Binding NewFolderCommand}" InputGestureText="{Binding Shortcuts[newFolder]}" />
        <MenuItem Header="이름 변경" Command="{Binding RenameCommand}" InputGestureText="{Binding Shortcuts[rename]}" />
        <MenuItem Header="삭제" Command="{Binding DeleteCommand}" InputGestureText="{Binding Shortcuts[delete]}" />
        <Separator />
        <MenuItem Header="파일 탐색기에서 열기" Command="{Binding OpenInExplorerCommand}" InputGestureText="{Binding Shortcuts[openInExplorer]}" />
        <Separator />
        <MenuItem Header="휴지통 비우기" Command="{Binding EmptyTrashCommand}" InputGestureText="{Binding Shortcuts[emptyTrash]}" />
        <MenuItem Header="금고 폴더 변경" Command="{Binding ChangeRootCommand}" InputGestureText="{Binding Shortcuts[changeRoot]}" />
        <Separator />
        <MenuItem Header="종료" Command="{Binding ExitCommand}" InputGestureText="{Binding Shortcuts[exit]}" />
      </MenuItem>
      <MenuItem Header="편집">
        <MenuItem Header="전체 복사" Command="{Binding CopyAllCommand}" IsEnabled="{Binding Editor.CanCopy}" InputGestureText="{Binding Shortcuts[copyAll]}" />
        <MenuItem Header="열었을 때 상태 보기" Command="{Binding OpenBackupCommand}" InputGestureText="{Binding Shortcuts[openBackup]}" />
        <Separator />
        <MenuItem Header="검색" Command="{Binding OpenFindBarCommand}" InputGestureText="{Binding Shortcuts[findBar]}" />
        <MenuItem Header="상세 검색" Command="{Binding OpenSearchWindowCommand}" InputGestureText="{Binding Shortcuts[searchVault]}" />
        <Separator />
        <!-- 음성 입력 (D-180) — .txt 는 서식 도구 막대가 없어 여기 · 단축키로만 켠다 -->
        <MenuItem Header="{Binding DictationMenuHeader}" Command="{Binding ToggleDictationCommand}" InputGestureText="{Binding Shortcuts[voiceInput]}" />
      </MenuItem>
      <MenuItem Header="보기">
        <MenuItem Header="새로고침" Command="{Binding RefreshCommand}" InputGestureText="{Binding Shortcuts[refresh]}" />
        <Separator />
        <!-- 본문 글꼴 (D-155) — 앱 전체 본문(.tbx · .txt). 지금 글꼴에 ✓ -->
        <MenuItem x:Name="FontMenu" Header="글꼴" ItemsSource="{Binding FontMenu}">
          <MenuItem.ItemContainerStyle>
            <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
              <Setter Property="Header" Value="{Binding Label}" />
              <Setter Property="IsChecked" Value="{Binding IsCurrent, Mode=OneWay}" />
              <Setter Property="Command" Value="{Binding DataContext.SetBodyFontCommand, RelativeSource={RelativeSource AncestorType=Menu}}" />
              <Setter Property="CommandParameter" Value="{Binding Id}" />
            </Style>
          </MenuItem.ItemContainerStyle>
        </MenuItem>
        <!-- 테마 (D-161) — 밝게 · 어둡게. 고르면 바로 바뀐다 — 열린 본문은 거뒀다 다시 연다(실행취소 기록 · 커서만 초기화). 지금 테마에 ✓ -->
        <MenuItem x:Name="ThemeMenu" Header="테마" ItemsSource="{Binding ThemeMenu}">
          <MenuItem.ItemContainerStyle>
            <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
              <Setter Property="Header" Value="{Binding Label}" />
              <Setter Property="IsChecked" Value="{Binding IsCurrent, Mode=OneWay}" />
              <Setter Property="Command" Value="{Binding DataContext.SetThemeCommand, RelativeSource={RelativeSource AncestorType=Menu}}" />
              <Setter Property="CommandParameter" Value="{Binding Id}" />
            </Style>
          </MenuItem.ItemContainerStyle>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="보안">
        <!-- 키를 바꿔 끼우면 열리는 문서가 달라진다. 잠그기는 키를 버리고 열린 문서를 닫는다 (D-048) -->
        <MenuItem Header="{Binding ChangeKeyLabel}" Command="{Binding ChangeKeyCommand}" InputGestureText="{Binding Shortcuts[changeKey]}" />
        <MenuItem Header="잠그기" Command="{Binding LockCommand}" InputGestureText="{Binding Shortcuts[lock]}" />
      </MenuItem>
      <MenuItem Header="도움말">
        <MenuItem Header="단축키" Command="{Binding OpenShortcutsCommand}" InputGestureText="{Binding Shortcuts[shortcuts]}" />
      </MenuItem>
    </Menu>

    <!-- Fluent 상태 줄은 바깥 여백 12 · 칸 여백 4 로 49px 이었다 [실측] — 예전과 비슷한 23px 로 (D-167, 사용자 판정 「보통」) -->
    <StatusBar DockPanel.Dock="Bottom" Padding="0" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0">
      <StatusBar.Resources>
        <Style TargetType="StatusBarItem" BasedOn="{StaticResource {x:Type StatusBarItem}}">
          <Setter Property="Padding" Value="8,3" />
        </Style>
      </StatusBar.Resources>
      <!-- 드래그 중 금지 커서만으로는 왜 안 되는지 알 수 없다. 사유를 여기에 띄운다. -->
      <TextBlock Text="{Binding DropHint}" Foreground="{DynamicResource HintTextBrush}" FontWeight="SemiBold" />
      <!-- 저장 여부가 어디에도 안 보이면 "저장 버튼이 반응 없다"로 느껴진다 -->
      <TextBlock Text="{Binding Editor.StatusText}" FontWeight="SemiBold" />
      <!-- 음성 입력 중일 때만 글자가 있다 — 어느 문서에 들어가는지까지 (plan R-9) -->
      <TextBlock Text="{Binding DictationStatusText}" Foreground="{DynamicResource DangerTextBrush}" />
      <Separator />
      <!-- 지금 어느 키를 쓰는지(몇 개가 맞는지)가 안 보이면 "문서가 안 열린다"를 고장으로 읽는다 -->
      <TextBlock Text="{Binding KeyStatusText}" />
      <Separator />
      <TextBlock Text="{Binding Editor.CurrentPath}" Foreground="Gray" />
      <Separator />
      <TextBlock Text="{Binding RootPath}" Foreground="Gray" />
    </StatusBar>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <TreeView Grid.Column="0" ItemsSource="{Binding Roots}"
                SelectedItemChanged="OnTreeSelectionChanged"
                PreviewMouseRightButtonDown="OnTreeRightClick"
                PreviewMouseLeftButtonDown="OnTreeDragStart"
                PreviewMouseMove="OnTreeDragMove"
                AllowDrop="True"
                DragOver="OnTreeDragOver"
                DragLeave="OnTreeDragLeave"
                Drop="OnTreeDrop">
        <TreeView.ContextMenu>
          <!-- TreeView 의 DataContext(ShellViewModel)를 그대로 물려받는다.
               명령은 모두 Selected 에 대해 동작하므로, 우클릭이 먼저 항목을 선택해야 한다. -->
          <ContextMenu>
            <MenuItem Header="새 폴더"   Command="{Binding NewFolderCommand}" />
            <MenuItem Header="새 문서"   Command="{Binding NewDocumentCommand}" />
            <Separator />
            <MenuItem Header="이름 변경" Command="{Binding RenameCommand}" />
            <MenuItem Header="삭제"      Command="{Binding DeleteCommand}" />
            <Separator />
            <MenuItem Header="열었을 때 상태 보기" Command="{Binding OpenBackupCommand}" />
            <Separator />
            <!-- 검색 창을 열기 전에 대상을 확정하는 가장 빠른 길 -->
            <MenuItem Header="이 폴더에서 찾기" Command="{Binding SearchInFolderCommand}" />
            <!-- "그 위치를 보러 간다"는 점에서 찾기와 같은 묶음. 폴더는 안을, 파일은 상위 폴더에서 선택해 연다 -->
            <MenuItem Header="파일 탐색기에서 열기" Command="{Binding OpenInExplorerCommand}" />
            <Separator />
            <MenuItem Header="새로고침"  Command="{Binding RefreshCommand}" />
          </ContextMenu>
        </TreeView.ContextMenu>
        <TreeView.ItemContainerStyle>
          <!-- SelectedItem이 읽기 전용이라, 선택을 코드에서 되돌리려면 컨테이너를 묶어야 한다 -->
          <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
          </Style>
        </TreeView.ItemContainerStyle>
        <TreeView.ItemTemplate>
          <!-- 금고 문서는 확장자를 감춰 보여주므로 기호가 없으면 폴더와 문서를 구분할 방법이 없다.
               평문 파일은 이름에 확장자가 남지만, 아이콘까지 자물쇠면 "암호화된 것"으로 읽힌다 —
               세 상태가 각각 다른 그림을 받아야 한다. -->
          <HierarchicalDataTemplate DataType="{x:Type vm:TreeNodeViewModel}" ItemsSource="{Binding Children}">
            <!-- 지금 키로 열리지 않는 문서는 흐리게 — 모든 .tbx 에 자물쇠 그림이 있어 자물쇠로는 구분이 안 된다.
                 그림을 새로 두지 않아 세 아이콘의 경계 상자 규칙(D-026)은 그대로다. -->
            <StackPanel Orientation="Horizontal" ToolTip="{Binding KeyStateTip}">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                      <Setter Property="Opacity" Value="{StaticResource DimmedOpacity}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <Image Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"
                     SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Style>
                  <Style TargetType="Image">
                    <Setter Property="Source" Value="{StaticResource DocumentLockedIcon}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsPlainText}" Value="True">
                        <Setter Property="Source" Value="{StaticResource DocumentPlainIcon}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsFolder}" Value="True">
                        <Setter Property="Source" Value="{StaticResource FolderIcon}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Image.Style>
              </Image>
              <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
            </StackPanel>
          </HierarchicalDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" />

      <DockPanel Grid.Column="2">
        <!-- 탭 머리글만 맡는다. 내용 영역은 비워 둔다 —
             ContentTemplate 은 TextBox 인스턴스를 하나만 만들어 돌려 써서, 본문이 같은 두 문서
             사이에 실행취소 스택이 넘어간다 [실측] (F-1). 본문은 아래 ItemsControl 이 탭마다 만든다.
             바깥 틀(TabControl 템플릿)만 다시 쓴다 — 탭이 넘쳐도 한 줄 · 넘김 · 목록 (D-074).
             TabItem 템플릿은 D-169 에서 다시 썼다(선택 탭 표시) — 머리글 ContentPresenter(ContentSource=Header)를
             빠뜨리면 빌드·파싱 모두 통과하고 머리글만 빈다 (LL-014). 내용 호스트(PART_SelectedContentHost)도 남긴다 —
             부품이 빠지면 TabStrip 이 던지고, 시험(TabStripTests)이 실제 템플릿을 적용해 본다. -->
        <!-- 글자색을 Fluent 본문 글자색으로 정한다 (D-168). TabStrip 은 TabControl 을 이어받은 직접 만든 컨트롤이라 Fluent 스타일이 붙지 않고
             예전 기본(검정)을 쓴다 — 어둡게에서 선택 안 된 탭 글자가 검게 묻혔다(사용자 실기 지적) [실측 — 사본] -->
        <platform:TabStrip x:Name="TabStrip" DockPanel.Dock="Top" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    ItemsSource="{Binding Tabs}"
                    SelectedItem="{Binding ActiveTab, Mode=TwoWay}"
                    BorderThickness="0" Padding="0" Background="Transparent"
                    TabListItemTemplate="{StaticResource TabListItemTemplate}"
                    PreviewMouseLeftButtonDown="OnTabDragStart"
                    PreviewMouseMove="OnTabDragMove"
                    AllowDrop="True"
                    DragEnter="OnTabDragEnter"
                    DragOver="OnTabDragOver"
                    DragLeave="OnTabDragLeave"
                    Drop="OnTabDrop">
          <platform:TabStrip.Template>
            <ControlTemplate TargetType="platform:TabStrip">
              <Grid ClipToBounds="True" SnapsToDevicePixels="True" KeyboardNavigation.TabNavigation="Local">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- [탭 줄 ......][◀][▶][▾] — 버튼은 오른쪽에 모은다. 넘침이 생겨도 첫 탭이 움직이지 않는다.
                     StackPanel 안의 TabPanel 은 폭 제한이 없어 접히지 않는다 [실측]. 끝 여백은 끝까지 넘겨도
                     왼쪽 끝이 온전한 탭이 되게 TabStrip 이 폭을 정한다 (D-076). -->
                <DockPanel x:Name="PART_HeaderArea" Panel.ZIndex="1" Background="Transparent">
                  <Button x:Name="PART_TabList" DockPanel.Dock="Right" ToolTip="열린 탭 목록" Style="{StaticResource TabStripButton}">
                    <Path Data="M0,0 L8,0 L4,4.5 Z" Width="8" Height="4.5" Stretch="Uniform" VerticalAlignment="Center"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Button>
                  <Button x:Name="PART_ScrollRight" DockPanel.Dock="Right" ToolTip="오른쪽으로" Style="{StaticResource TabStripButton}">
                    <Path Data="M0,0 L4.5,4.5 L0,9 Z" Width="4.5" Height="9" Stretch="Uniform" VerticalAlignment="Center"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Button>
                  <Button x:Name="PART_ScrollLeft" DockPanel.Dock="Right" ToolTip="왼쪽으로" Style="{StaticResource TabStripButton}">
                    <Path Data="M4.5,0 L0,4.5 L4.5,9 Z" Width="4.5" Height="9" Stretch="Uniform" VerticalAlignment="Center"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Button>
                  <ScrollViewer x:Name="PART_HeaderScroll" Focusable="False" CanContentScroll="False"
                                HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal">
                      <TabPanel x:Name="PART_HeaderPanel" IsItemsHost="True" Margin="2,2,2,0" Background="Transparent"
                                KeyboardNavigation.TabIndex="1" />
                      <Border x:Name="PART_EndSpacer" Width="0" />
                    </StackPanel>
                  </ScrollViewer>
                </DockPanel>
                <Border Grid.Row="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" KeyboardNavigation.DirectionalNavigation="Contained"
                        KeyboardNavigation.TabIndex="2" KeyboardNavigation.TabNavigation="Local">
                  <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"
                                    Margin="{TemplateBinding Padding}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                </Border>
              </Grid>
            </ControlTemplate>
          </platform:TabStrip.Template>
          <platform:TabStrip.ItemTemplate>
            <!-- ItemTemplate 이 없으면 머리글에 클래스 풀네임이 그대로 뜬다 (LL-016) -->
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource TabStateIcon}" Margin="0,0,5,0" />
                <!-- 아주 긴 제목은 말줄임 — 줄보다 넓은 탭은 ✕ 가 안 보인다. 전체 제목은 마우스를 올리면 (D-081) -->
                <TextBlock Text="{Binding TabTitle}" VerticalAlignment="Center" MaxWidth="240"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding TabTitle}" />
                <!-- 포커스를 받지 않는다 — 받으면 WPF 가 BringIntoView 를 불러, 오른쪽에 잘린 탭의 ✕ 를 누르는 순간
                     줄이 탭 하나만큼 넘어가 ✕ 가 커서 밑에서 빠진다 [실측 — 적대 검토]. 키보드로 닫기는 Ctrl+W. -->
                <Button Content="✕" Margin="8,0,0,0" Padding="4,0" FontSize="10" Focusable="False"
                        BorderThickness="0" Background="Transparent" Foreground="Gray"
                        ToolTip="탭 닫기"
                        Command="{Binding DataContext.CloseTabCommand,
                                  RelativeSource={RelativeSource AncestorType=TabControl}}"
                        CommandParameter="{Binding}" />
              </StackPanel>
            </DataTemplate>
          </platform:TabStrip.ItemTemplate>
          <platform:TabStrip.ItemContainerStyle>
            <!-- AncestorType=TabControl 은 하위 클래스(TabStrip)도 찾는다 [실측 — 계획 검토] -->
            <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
              <!-- 선택 탭 (D-169, 사용자 판정 A2). Fluent 탭 모양은 테두리 설정을 무시해 [실측 — 사본] 모양을 직접 그린다:
                   선택 탭 = 위쪽 강조선 + 서식 도구 모음 색 바탕 — 아래 도구 모음과 한 덩어리로 이어진다. 탭 줄 뒤는 창 바탕.
                   머리글 ContentPresenter 를 빠뜨리면 머리글만 빈다 (LL-014) -->
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Face" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,2,0,0"
                            CornerRadius="4,4,0,0" Padding="10,4,6,4" Margin="0,0,2,0">
                      <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Face" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Face" Property="Background" Value="{DynamicResource FormatBarBrush}" />
                        <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
              <!-- ContextMenu 는 별도 팝업 트리라 TabControl 을 조상으로 찾지 못한다.
                   위 ✕ 버튼이 쓰는 AncestorType 관용구를 메뉴 안에 복사하면 Command 가 null 이 되고,
                   빌드·파싱·테스트·경고 0 을 전부 통과한 채 "눌러도 무반응"으로만 드러난다 [실측].
                   그래서 셸을 Tag 에 실어 PlacementTarget 경유로 건넨다. -->
              <Setter Property="Tag"
                      Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TabControl}}" />
              <Setter Property="ContextMenu">
                <Setter.Value>
                  <!-- 우클릭은 탭을 선택하지 않는다 [실측]. 선택을 옮기는 대신
                       PlacementTarget.DataContext 로 우클릭한 탭을 직접 넘긴다 —
                       배경 탭을 우클릭해도 화면이 그리로 튀지 않는다. -->
                  <ContextMenu>
                    <MenuItem Header="닫기"
                              Command="{Binding PlacementTarget.Tag.CloseTabCommand,
                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.DataContext,
                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <Separator />
                    <!-- 파괴적인 두 항목은 구분선 아래로 내린다 — 오클릭을 줄인다 -->
                    <MenuItem Header="다른 탭 닫기"
                              Command="{Binding PlacementTarget.Tag.CloseOtherTabsCommand,
                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.DataContext,
                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="모든 탭 닫기"
                              Command="{Binding PlacementTarget.Tag.CloseAllTabsCommand,
                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                  </ContextMenu>
                </Setter.Value>
              </Setter>
            </Style>
          </platform:TabStrip.ItemContainerStyle>
          <platform:TabStrip.ContentTemplate>
            <!-- 내용은 아래에서 그린다. 비워 두지 않으면 선택된 탭의 ToString() 이 노출된다 -->
            <DataTemplate>
              <Grid Height="0" />
            </DataTemplate>
          </platform:TabStrip.ContentTemplate>
        </platform:TabStrip>

        <!-- 문서 안에서 찾기. 본문을 가리지 않도록 띠로 둔다 —
             찾기 창이 찾으려는 본문을 가리는 것이 오래된 불만이다.
             DataContext 를 활성 탭으로 두면 검색창의 복사 가로채기가 그대로 붙는다. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" Padding="8,6"
                BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1"
                DataContext="{Binding Editor}"
                Visibility="{Binding DataContext.IsFindBarOpen,
                             RelativeSource={RelativeSource AncestorType=Window},
                             Converter={StaticResource BoolToVisibility}}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding MatchPositionText}" Margin="10,0,4,0"
                       VerticalAlignment="Center" Foreground="Gray" MinWidth="52"
                       TextAlignment="Right" />
            <Button DockPanel.Dock="Right" Content="✕" Padding="6,0" BorderThickness="0"
                    Background="Transparent" Foreground="Gray" ToolTip="{Binding DataContext.CloseFindBarToolTip, RelativeSource={RelativeSource AncestorType=Window}}"
                    Command="{Binding DataContext.CloseFindBarCommand,
                              RelativeSource={RelativeSource AncestorType=Window}}" />
            <CheckBox DockPanel.Dock="Right" Content="Aa" Margin="10,0,0,0" VerticalAlignment="Center"
                      ToolTip="대소문자 구분" IsChecked="{Binding MatchCase}" />
            <Button DockPanel.Dock="Right" Content="▼" Padding="6,0" BorderThickness="0"
                    Background="Transparent" ToolTip="{Binding DataContext.FindNextToolTip, RelativeSource={RelativeSource AncestorType=Window}}"
                    Command="{Binding DataContext.FindNextCommand,
                              RelativeSource={RelativeSource AncestorType=Window}}" />
            <Button DockPanel.Dock="Right" Content="▲" Padding="6,0" BorderThickness="0"
                    Background="Transparent" ToolTip="{Binding DataContext.FindPrevToolTip, RelativeSource={RelativeSource AncestorType=Window}}"
                    Command="{Binding DataContext.FindPrevCommand,
                              RelativeSource={RelativeSource AncestorType=Window}}" />
            <TextBox x:Name="FindBox"
                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     platform:EditorBehavior.InterceptCopySelection="True"
                     IsUndoEnabled="False"
                     AllowDrop="False" Padding="4,2"
                     FontFamily="{x:Static platform:AppFonts.Fixed}" FontSize="12">
              <!-- 검색어 자체가 비밀값이다. 실행취소 스택은 새 저장소가 되고,
                   맨 TextBox 는 클립보드 기록 제외를 타지 않는다 [실측]. -->
              <TextBox.InputBindings>
                <KeyBinding Key="Enter"
                            Command="{Binding DataContext.FindNextCommand,
                                      RelativeSource={RelativeSource AncestorType=Window}}" />
                <KeyBinding Key="Enter" Modifiers="Shift"
                            Command="{Binding DataContext.FindPrevCommand,
                                      RelativeSource={RelativeSource AncestorType=Window}}" />
              </TextBox.InputBindings>
            </TextBox>
          </DockPanel>
        </Border>

        <!-- 본문 자리는 문서가 없어도 입력 칸 바탕으로 칠한다 (D-166). Fluent 는 창 바탕(Mica)이 비치고 트리 · 구분 막대가 투명해,
             칠하지 않으면 문서가 없을 때 트리와 본문의 경계가 사라진다(사용자 실기 지적). 탭 줄 뒤는 칠하지 않는다 — 선택 탭이 도드라지게 (D-169) -->
        <Grid Background="{DynamicResource TextControlBackground}">
          <TextBlock Text="왼쪽에서 문서를 고르세요" Foreground="Gray" Margin="16"
                     Visibility="{Binding HasNoTabs, Converter={StaticResource BoolToVisibility}}" />

          <!-- ItemsControl 은 항목마다 컨테이너를 만든다 — 여기서 탭별 TextBox 가 생긴다.
               모두 한 칸에 겹쳐 두고 활성 탭만 보인다. 그래서 실행취소·캐럿·스크롤이 문서에 속한다. -->
          <ItemsControl x:Name="TabBodies" ItemsSource="{Binding Tabs}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <Grid />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                  <!-- 띠가 보이는 조건은 IsReadOnly 인데 문구는 LockReason 에 묶여 있다.
                       평문 경로가 문구를 비우면 글자 없는 붉은 띠가 그려진다 — 반드시 채운다. -->
                  <Border DockPanel.Dock="Top" Padding="12,10" BorderThickness="0,0,0,1"
                          Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibility}}">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource LockBannerBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource LockBannerLineBrush}" />
                        <Style.Triggers>
                          <!-- 평문은 고장이 아니라 정상 동작이다. 붉은 톤을 그대로 쓰면
                               사용자가 앱이 망가졌다고 읽는다. -->
                          <DataTrigger Binding="{Binding IsPlainText}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource PlainBannerBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource PlainBannerLineBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding LockReason}" TextWrapping="Wrap">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{DynamicResource HintTextBrush}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPlainText}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Border>
                  <!-- 본문: .txt 는 TextBox, .tbx 는 서식 본문 (D-125). 확장자는 이름 변경으로 바뀌지 않는다(D-018). -->
                  <ContentControl Content="{Binding}" Focusable="False" IsTabStop="False">
                    <ContentControl.Style>
                      <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{StaticResource RichBodyTemplate}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsPlainTextFile}" Value="True">
                            <Setter Property="ContentTemplate" Value="{StaticResource PlainBodyTemplate}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </ContentControl.Style>
                  </ContentControl>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
