<Window x:Class="TextBean.Views.Dialogs.KeyPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:platform="clr-namespace:TextBean.Views.Platform"
        Width="440" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">
  <!-- 평소에는 PasswordBox 다. PasswordBox 는 한글 입력기를 강제로 끄고(D-051) 복사·실행취소 기록이 없다.
       눈 버튼을 누른 동안만 평문 칸(TextBox)에 보인다. 그 칸도 같은 성질이어야 한다 —
       실행취소 기록 끔 · 한글 입력기 끔 · 복사·잘라내기·끌어 놓기 막음(클립보드는 다른 앱과 Win+V 기록이 본다).
       창을 열 때마다 가려진 채로 시작한다(창을 매번 새로 만든다). -->
  <Window.Resources>
    <Style x:Key="EyeToggle" TargetType="ToggleButton">
      <Setter Property="Width" Value="30" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Margin" Value="0,1,1,1" />
      <!-- 누른 뒤 입력칸으로 초점을 돌려준다. 버튼이 초점을 가져가면 Tab 순서가 입력칸 사이에서 끊긴다 -->
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="ToolTip" Value="키 보기" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border Background="Transparent">
              <TextBlock x:Name="Glyph" Text="&#xE890;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                         Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Glyph" Property="Text" Value="&#xED1A;" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Glyph" Property="Foreground"
                        Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="ToolTip" Value="키 가리기" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- 보이는 칸. 고정폭 글꼴이라 l·1·I, O·0 을 가를 수 있다 -->
    <Style x:Key="ShownKey" TargetType="TextBox">
      <Setter Property="Padding" Value="6,6,32,6" />
      <Setter Property="Visibility" Value="Collapsed" />
      <Setter Property="IsUndoEnabled" Value="False" />
      <Setter Property="InputMethod.IsInputMethodEnabled" Value="False" />
      <Setter Property="FontFamily" Value="{x:Static platform:AppFonts.Fixed}" />
    </Style>
  </Window.Resources>

  <StackPanel Margin="16">
    <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,0,0,12" />

    <TextBlock Text="키" Margin="0,0,0,4" />
    <Grid Margin="0,0,0,8">
      <PasswordBox x:Name="First" Padding="6,6,32,6" />
      <TextBox x:Name="FirstShown" Style="{StaticResource ShownKey}" DataObject.Copying="OnShownCopying" />
      <ToggleButton x:Name="FirstEye" Style="{StaticResource EyeToggle}" Checked="OnEyeChanged" Unchecked="OnEyeChanged" />
    </Grid>

    <StackPanel x:Name="ConfirmPanel">
      <TextBlock Text="한 번 더 입력" Margin="0,0,0,4" />
      <Grid Margin="0,0,0,8">
        <PasswordBox x:Name="Second" Padding="6,6,32,6" />
        <TextBox x:Name="SecondShown" Style="{StaticResource ShownKey}" DataObject.Copying="OnShownCopying" />
        <ToggleButton x:Name="SecondEye" Style="{StaticResource EyeToggle}" Checked="OnEyeChanged" Unchecked="OnEyeChanged" />
      </Grid>
    </StackPanel>

    <!-- 키는 대소문자를 가린다. Caps Lock 이 켜진 채 치면 다른 키가 된다 -->
    <TextBlock x:Name="CapsLockHint" Text="Caps Lock 이 켜져 있습니다" Foreground="{DynamicResource CautionTextBrush}" FontSize="12"
               Margin="0,0,0,8" Visibility="Collapsed" />

    <TextBlock Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"
               Text="한글은 입력되지 않습니다 · 키를 붙여넣었다면 클립보드 기록(Win+V)도 지우세요" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="취소" Width="80" Margin="0,0,8,0" IsCancel="True" />
      <Button Content="확인" Width="80" IsDefault="True" Click="OnOk" />
    </StackPanel>
  </StackPanel>
</Window>
