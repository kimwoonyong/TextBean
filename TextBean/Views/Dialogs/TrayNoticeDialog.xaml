<Window x:Class="TextBean.Views.Dialogs.TrayNoticeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TextBean" Width="360" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">
  <!-- 첫 ✕ 때 한 번만 뜬다 (D-096 · D-109). 꼭 알아야 할 세 가지(키 유지 · 절전 잠금 · 끄는 법)만 두 줄로 -->
  <StackPanel Margin="20,18,20,14">
    <TextBlock x:Name="Heading" Text="알림 영역으로 숨깁니다" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />
    <TextBlock x:Name="Body" Foreground="{DynamicResource NoticeTextBrush}" LineHeight="20" TextWrapping="Wrap">
      <Run Text="키는 그대로 남습니다. 절전하면 잠깁니다." /><LineBreak />
      <Run Text="끄기: 아이콘 우클릭 → 종료 · Ctrl+Q" />
    </TextBlock>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="숨기기" Width="80" Margin="0,0,8,0" IsDefault="True" Click="OnHide" />
      <Button Content="취소" Width="80" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
