<Window x:Class="TextBean.Views.Dialogs.ShortcutsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="단축키" Width="440" Height="560" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False">
  <!-- 줄을 고르고 [키 바꾸기] → 새 키를 누른다. 막히거나 겹치면 아래 빨간 줄에 이유 (D-110 · D-114) -->
  <DockPanel Margin="14">
    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <Button Content="닫기" Width="76" DockPanel.Dock="Right" IsCancel="True" />
      <Button Content="초기화" Width="76" DockPanel.Dock="Right" Margin="0,0,8,0" Command="{Binding ResetCommand}"
              ToolTip="모든 키를 처음 키로 되돌립니다" />
      <Button Content="키 바꾸기" Width="88" HorizontalAlignment="Left" Command="{Binding ChangeCommand}" />
    </DockPanel>

    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" Foreground="{DynamicResource ErrorTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />

    <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding FixedKeys}" Margin="0,10,0,0" Foreground="Gray">
      <ItemsControl.Template>
        <ControlTemplate TargetType="ItemsControl">
          <StackPanel>
            <TextBlock Text="고정 키 (바꿀 수 없음)" FontSize="11" Margin="4,0,0,4" />
            <ItemsPresenter />
          </StackPanel>
        </ControlTemplate>
      </ItemsControl.Template>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid Margin="4,1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Name}" />
            <TextBlock Grid.Column="1" Text="{Binding Keys}" FontFamily="Cascadia Mono, Consolas" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <ListView x:Name="List" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <!-- 줄을 두 번 누르면 바로 키 받기 — [키 바꾸기]와 같다 -->
      <ListView.ItemContainerStyle>
        <!-- 표(GridView) 줄 모양을 이어받는다 — 일반 ListViewItem 모양을 이어받으면 칸 대신 줄 객체 이름이 찍힌다 [실측 — 렌더] (D-163) -->
        <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
          <EventSetter Event="MouseDoubleClick" Handler="OnRowDoubleClick" />
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.View>
        <GridView>
          <GridViewColumn Header="동작" Width="180" DisplayMemberBinding="{Binding Name}" />
          <GridViewColumn Header="키" Width="185">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding KeyText}" FontFamily="Cascadia Mono, Consolas">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Key}" Value="{x:Null}">
                          <Setter Property="Foreground" Value="Gray" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
        </GridView>
      </ListView.View>
    </ListView>
  </DockPanel>
</Window>
