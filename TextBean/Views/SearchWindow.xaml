<Window x:Class="TextBean.Views.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:platform="clr-namespace:TextBean.Views.Platform"
        Title="찾기" Width="440" Height="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Window.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
  </Window.InputBindings>

  <DockPanel Margin="12">
    <!-- 찾을 내용 -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <Button DockPanel.Dock="Right" Content="찾기" Padding="16,4" Margin="8,0,0,0"
              IsDefault="True" Command="{Binding RunCommand}" />
      <!-- 검색어 자체가 비밀값이다 — 실행취소 스택은 새 저장소가 되고,
           맨 TextBox 는 클립보드 기록 제외를 타지 않는다 [실측]. -->
      <TextBox x:Name="QueryBox"
               Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
               IsUndoEnabled="False" AllowDrop="False" Padding="5,4"
               FontFamily="{x:Static platform:AppFonts.Body}" FontSize="13" />
    </DockPanel>

    <!-- 범위. 착각하면 "금고에 없다"는 거짓 결론이 나오므로 셋을 한눈에 둔다 -->
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <RadioButton Content="전체" GroupName="scope" Margin="0,3"
                   IsChecked="{Binding IsAllScope, Mode=TwoWay}" />
      <DockPanel Margin="0,3">
        <RadioButton Content="폴더 하위" GroupName="scope" VerticalAlignment="Center" MinWidth="74"
                     IsChecked="{Binding IsFolderScope, Mode=TwoWay}" />
        <!-- 고를 수단이 없으면 범위를 바꿀 방법이 없다. 트리 선택에만 기대면
             창이 메인 창을 가린 상태에서 어느 폴더인지도, 바꾸는 법도 모른다. -->
        <Button DockPanel.Dock="Right" Content="고르기…" Padding="10,2" Margin="8,0,0,0"
                Command="{Binding PickFolderCommand}" />
        <TextBlock Text="{Binding ScopeFolderName}" Margin="8,0,0,0" VerticalAlignment="Center"
                   Foreground="Gray" TextTrimming="CharacterEllipsis" />
      </DockPanel>
      <DockPanel Margin="0,3">
        <RadioButton Content="이 문서" GroupName="scope" VerticalAlignment="Center" MinWidth="74"
                     IsChecked="{Binding IsDocumentScope, Mode=TwoWay}" />
        <!-- 금고 안 문서 아무거나 고른다 — 열려 있지 않아도 된다.
             열린 것 중에서만 고를 수 있으면 "금고에 없다"는 거짓 답이 나온다. -->
        <Button DockPanel.Dock="Right" Content="고르기…" Padding="10,2" Margin="8,0,0,0"
                Command="{Binding PickDocumentCommand}" />
        <TextBlock Text="{Binding ScopeDocumentName}" Margin="8,0,0,0" VerticalAlignment="Center"
                   Foreground="Gray" TextTrimming="CharacterEllipsis" />
      </DockPanel>
      <CheckBox Content="대소문자 구분" Margin="0,8,0,0" IsChecked="{Binding MatchCase}" />
    </StackPanel>

    <!-- 진행·취소 -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6"
               Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
      <Button DockPanel.Dock="Right" Content="취소" Padding="12,2" Margin="8,0,0,0"
              Command="{Binding CancelCommand}" />
      <ProgressBar IsIndeterminate="True" Height="4" VerticalAlignment="Center" />
    </DockPanel>

    <!-- 결과 헤더. 범위와 '못 본 것'을 같이 적는다 -->
    <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" TextWrapping="Wrap"
               Margin="0,0,0,6" Foreground="#5F5E5A" />
    <Border DockPanel.Dock="Top" Background="#FAEEDA" BorderBrush="#EF9F27" BorderThickness="1"
            Padding="8,6" Margin="0,0,0,8" CornerRadius="3"
            Visibility="{Binding HasBlindSpots, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="확인하지 못한 곳이 있습니다. 이 결과를 '없다'로 읽지 마세요."
                 TextWrapping="Wrap" Foreground="#854F0B" />
    </Border>

    <TabControl>
      <TabItem Header="내용">
        <!-- 결과에 본문 조각을 싣지 않는다 (C-03) — 열지도 않은 문서의 평문이
             목록을 타고 화면에 늘어서는 것을 막는다. 문맥은 문서를 열어서 본다. -->
        <ListBox ItemsSource="{Binding Results}"
                 SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                 HorizontalContentAlignment="Stretch" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <!-- 클릭마다 연다. 선택 변화에 매달면 같은 항목을 다시 눌렀을 때 죽는다.
                   Background 를 줘야 행 전체가 클릭을 받는다. -->
              <DockPanel Margin="0,3" Background="Transparent">
                <DockPanel.InputBindings>
                  <MouseBinding MouseAction="LeftClick"
                                Command="{Binding DataContext.OpenHitCommand,
                                          RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}" />
                </DockPanel.InputBindings>
                <TextBlock DockPanel.Dock="Right" Text="{Binding MatchCount}"
                           Foreground="Gray" Margin="8,0,0,0" />
                <!-- 결과 목록에는 아이콘이 없다. 이 표시가 없으면 사용자는 열기 전까지
                     그것이 잠긴 문서인지 평문인지 알 수 없다. -->
                <TextBlock DockPanel.Dock="Right" Text="평문" FontSize="11" Margin="8,0,0,0"
                           VerticalAlignment="Center" Foreground="#854F0B">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPlainText}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </TabItem>
      <TabItem Header="이름">
        <!-- 이름은 평문이라 복호화가 0회다. 입력 즉시 갱신된다. -->
        <ListBox ItemsSource="{Binding NameResults}"
                 SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                 HorizontalContentAlignment="Stretch" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="0,3" Background="Transparent">
                <DockPanel.InputBindings>
                  <MouseBinding MouseAction="LeftClick"
                                Command="{Binding DataContext.OpenHitCommand,
                                          RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}" />
                </DockPanel.InputBindings>
                <TextBlock DockPanel.Dock="Right" Text="평문" FontSize="11" Margin="8,0,0,0"
                           VerticalAlignment="Center" Foreground="#854F0B">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPlainText}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
